<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.toolstore.installer"
    android:versionCode="13"
    android:versionName="0.3.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- The bundled adb client reaches the TV directly on the local network.
         There is deliberately no storage, location, overlay or accessibility
         permission: this app only operates the TV over an authorized ADB link. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only for handing the official-site-linked Clean Your TV phone app to
         the visible system installer. The app never installs silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:debuggable="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="工具市场"
        android:supportsRtl="true"
        android:theme="@style/Theme.ToolStore"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".PhoneInstallReceiver"
            android:exported="false" />
    </application>
</manifest>