<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:elevation="1.5dp"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.toolstore.installer.RoundedImageView
            android:id="@+id/appLogo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="应用图标"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PlanYourTV"
                android:textColor="@color/text"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/appTagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="儿童桌面 · 答题 · 时间管理"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <com.toolstore.installer.FlowLayout
                android:id="@+id/appBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/appAction"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:minWidth="58dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="安装"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/appDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:text=""
        android:textColor="@color/text_2"
        android:textSize="12.5sp" />

    <com.toolstore.installer.FlowLayout
        android:id="@+id/appFeatures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:id="@+id/appNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="vertical" />
</LinearLayout>