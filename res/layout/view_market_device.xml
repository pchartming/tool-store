<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/marketDeviceCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:background="@drawable/bg_device_offline"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/marketDeviceIconWrap"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_round_white">

        <com.toolstore.installer.LineIconView
            android:id="@+id/marketDeviceIcon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/marketDeviceDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_badge_amber" />

            <TextView
                android:id="@+id/marketDeviceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="未连接电视"
                android:textColor="@color/amber"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/marketDeviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="连接你的电视"
            android:textColor="@color/text"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/marketDeviceMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="同一 Wi-Fi · 自动发现或输入 IP"
            android:textColor="@color/muted"
            android:textSize="10.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/marketDeviceCta"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginLeft="8dp"
        android:background="@drawable/bg_button_secondary"
        android:gravity="center"
        android:minWidth="56dp"
        android:paddingLeft="11dp"
        android:paddingRight="11dp"
        android:text="去准备"
        android:textColor="@color/accent"
        android:textSize="11.5sp"
        android:textStyle="bold" />
</LinearLayout>