<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_nav"
    android:orientation="horizontal"
    android:paddingLeft="28dp"
    android:paddingTop="5dp"
    android:paddingRight="28dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:id="@+id/navMarket"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/navMarketIconWrap"
            android:layout_width="38dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_nav_selected">

            <com.toolstore.installer.LineIconView
                android:id="@+id/navMarketIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/navMarketLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="工具市场"
            android:textColor="@color/accent"
            android:textSize="10.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navDevice"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/navDeviceIconWrap"
            android:layout_width="38dp"
            android:layout_height="24dp"
            android:background="@android:color/transparent">

            <com.toolstore.installer.LineIconView
                android:id="@+id/navDeviceIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center" />

            <View
                android:id="@+id/navDeviceDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="1dp"
                android:layout_marginRight="3dp"
                android:background="@drawable/bg_badge_green"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/navDeviceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="我的电视"
            android:textColor="@color/nav_unselected"
            android:textSize="10.5sp" />
    </LinearLayout>
</LinearLayout>