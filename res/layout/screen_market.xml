<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/marketScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/searchBox"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="6dp">

            <com.toolstore.installer.LineIconView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:id="@+id/searchIcon" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="搜索桌面、答题、清理…"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="#9AA7B7"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/searchClear"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:clickable="true"
                android:contentDescription="清除搜索"
                android:focusable="true"
                android:visibility="gone">

                <com.toolstore.installer.LineIconView
                    android:id="@+id/searchClearIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:text="全部 6"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterLauncher"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginLeft="7dp"
                android:gravity="center"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:text="桌面 5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterTool"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginLeft="7dp"
                android:gravity="center"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:text="工具 1"
                android:textSize="12sp" />
        </LinearLayout>

        <include layout="@layout/view_market_device" />

        <LinearLayout
            android:id="@+id/marketSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_safety"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_note_green">

                <com.toolstore.installer.LineIconView
                    android:id="@+id/safetyIcon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="安全安装边界"
                    android:textColor="@color/text"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="只动第三方应用 · 安装前校验 · 不改系统桌面"
                    android:textColor="@color/muted"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/marketCuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_curation"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="13dp">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_button_secondary">

                <com.toolstore.installer.LineIconView
                    android:id="@+id/curationIcon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="好工具，值得被看见"
                    android:textColor="@color/accent_strong"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="提交推荐，由站长审核后收录上架"
                    android:textColor="#5E7FA6"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <com.toolstore.installer.LineIconView
                android:id="@+id/curationChevron"
                android:layout_width="16dp"
                android:layout_height="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/marketFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="只连接家庭局域网 · 不把 5555 暴露到公网"
            android:textColor="@color/muted"
            android:textSize="10.5sp" />
    </LinearLayout>
</ScrollView>